{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SessionLifecycle": {
    "IdleThreshold": "00:30:00",
    "SweepInterval": "00:01:00",
    "MaxSessions": 100
  },
  "ConnectionLimits": { "MaxMessageBytes": 1048576 },
  "AllowedHosts": "*"
}
